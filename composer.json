{
    "name": "smartlabsys/sls-connector-bundle",
    "description": "Connects a Symfony app to the Smartlab Systems platform (SLS): manifest, SSO, provisioning, SCIM, webhooks.",
    "type": "symfony-bundle",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^6.10 || ^7.0",
        "symfony/cache": "^7.4",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/security-bundle": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/dom-crawler": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/translation": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "suggest": {
        "symfony/twig-bundle": "For the sls_login_url() Twig function"
    },
    "autoload": {
        "psr-4": {
            "Smartlabsys\\SlsConnectorBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Smartlabsys\\SlsConnectorBundle\\Tests\\": "tests/",
            "Smartlabsys\\SlsConnectorBundle\\Tests\\App\\": "tests/App/src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
